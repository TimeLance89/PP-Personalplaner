# PP – Personalplaner
PP_HOST=0.0.0.0
PP_PORT=8780
PP_DATA_DIR=/app/data
TZ=Europe/Berlin
PUID=1000
PGID=1000

# First setup. If empty, PP generates data/setup-token.txt and logs the token once.
PP_SETUP_TOKEN=

# Security / reverse proxy
PP_ALLOWED_HOSTS=
PP_COOKIE_SECURE=false
PP_SESSION_HOURS=12

# Company details used in agency emails
PP_COMPANY_NAME=Meine Firma
PP_COMPANY_CONTACT=Personalplanung

# SMTP. Leave SMTP_HOST empty to keep requests in "mail_failed" until configured/retried.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false
